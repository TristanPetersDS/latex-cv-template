\dim_const:Nn \c__cv_bullet_gap_dim { 0.10 cm }   % between a position header and its bullets
\dim_const:Nn \c__cv_course_indent_dim { 0.45 cm }  % nested courses sit this far in from the position
\dim_const:Nn \c__cv_work_date_dim   { 2.2 cm }    % date column of publications / presentations
\tl_new:N   \g__cv_author_font_tl                 % author lists of publications / presentations
\tl_gset:Nn \g__cv_author_font_tl { \small }
\bool_new:N \g__cv_first_bool
\bool_gset_true:N \g__cv_first_bool

\tl_new:N   \l__cv_kind_tl
\tl_new:N   \l__cv_name_tl
\tl_new:N   \l__cv_form_tl
\prop_new:N \l__cv_rec_prop
\str_new:N  \l__cv_key_str
\seq_new:N  \l__cv_parts_seq
\seq_new:N  \l__cv_lines_seq
\seq_new:N  \l__cv_labels_seq
\bool_new:N \l__cv_found_bool
\bool_new:N \l__cv_has_bullets_bool
\tl_new:N   \l__cv_title_tl
\tl_new:N   \l__cv_org_tl
\tl_new:N   \l__cv_location_tl
\tl_new:N   \l__cv_type_tl
\tl_new:N   \l__cv_authors_tl
\tl_new:N   \l__cv_venue_tl
