\tl_new:N   \l__cv_bullets_tl
\tl_new:N   \l__cv_bkey_tl
\tl_new:N   \l__cv_courses_tl
\clist_new:N \l__cv_courses_clist
\tl_new:N   \l__cv_body_tl
