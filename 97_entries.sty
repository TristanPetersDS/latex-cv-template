\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{97_entries}[2026/11/17 CV entry records]
% ============================================================
% 97_entries.sty -- entry records: every CV/resume entry is defined ONCE as
% data and rendered by one shared macro per kind. Loaded by every main file,
% after 99_preamble.sty (it renders through the preamble's twocolentry,
% onecolentry and \positionEntries; its header row reproduces \newPosition).
%
% DEFINING (in the numbered data files):
%   \DefinePosition{Name}{ key = value, ... }       jobs, degrees, certs, honors
%   \DefineCourse{Name}{ key = value, ... }         a course taught, shown under a position
%   \DefinePublication{Name}{ key = value, ... }    papers, manuscripts
%   \DefinePresentation{Name}{ key = value, ... }   posters, talks
%   \DefineReference{Name}{ key = value, ... }      referees
%   \DefineSkills{Name}{ Label = {items}, ... }     skill blocks (ordered)
%   \DefineParagraph{Name}{text}                    summaries, interests
% Each \Define... creates the command \Name. A name is letters only and must
% not be a command that already exists. Brace every value that contains a
% comma; write \# for a # inside a URL.
%
% KEYS (* = required; "dates" = the date keys described under DATES, required):
%   position      title*, org, location, bullets, courses, dates
%   course        title*, type, bullets, dates
%   publication   title*, authors*, venue*, note, dates
%   presentation  title*, type*, authors, venue*, note, dates
%   reference     name*, affiliation*, relationship*, confirmed*, email, phone
%
% FORMS -- one record can hold several versions of an item, one per kind of
% document, and each main file picks the version it wants:
%   full   everything (the default; used by a master CV)
%   acad   a tighter version for a page-limited CV (positions and courses only)
%   short  one line, for a section that a document shows in brief
%   tut    wording for a resume with a different reader (positions and courses only)
%   Skills, paragraphs and references have no forms.
%   Any key X other than a date key can be overridden per form as "short X" /
%   "tut X" / "acad X"; otherwise the form uses X. Dates are the same in every
%   form. BULLETS NEVER INHERIT: a position rendered in
%   a form needs that form's bullets ("bullets", "short bullets",
%   "tut bullets"); use "<form> bullets = none" for a header-only line.
%
% COURSES -- a teaching position can carry the courses taught in it:
%   \DefineCourse{CourseX}{ title = {PHYS 2A, General Physics}, type = {laboratory},
%                           date = {Fall 2023}, bullets = { \item ... } }
%   \DefinePosition{...}{ ..., courses = {CourseX, CourseY} }
%   They print under the position's bullets, indented, under "Courses taught".
%   Like bullets, courses never inherit: the full form shows "courses"; another
%   form shows them only if it has its own list ("short courses = {...}").
%
% DATES -- always rendered in full, 3-letter months, "--" ranges:
%   start = 2023-01, end = 2023-12   ->  Jan -- Dec 2023
%   start = 2025-09, end = present   ->  Sep 2025 -- Present
%   date  = 2023-12                  ->  Dec 2023
%   date  = {Spring 2020}            ->  printed as-is (any non-numeric text)
%   start and end must have the same precision (both YYYY or both YYYY-MM).
%
% USING (in a main file):
%   \SetEntryForm{short}   document default form (initially full)
%   \SetEntryGap{0.04cm}   space between entries (initially 0.10 cm)
%   \SetAuthorFont{\footnotesize}  size of author lists (initially \small;
%                          \normalsize restores the body size)
%   \Name  or  \Name[form] print the entry, in the default form or the one named.
%                          Entries space themselves: no gap before the first
%                          entry after \section / \subsection.
%
% Every mistake (unknown or repeated key, unbraced comma, missing or malformed
% bullets, missing required key, bad date, unknown form, bad or taken entry
% name, unknown course, duplicate skill label, unconfirmed reference) stops
% the build with an error.
% ============================================================
\RequirePackage[normalem]{ulem}
\renewcommand{\ULthickness}{0.1pt}

\ExplSyntaxOn

% ------------------------------------------------------------
% Messages
% ------------------------------------------------------------
\msg_new:nnn { cv-entries } { name-taken }
  { Cannot~define~entry~'#1':~the~command~\iow_char:N\\#1~already~exists. }
\msg_new:nnn { cv-entries } { unknown-key }
  { Entry~'#1'~(#2):~unknown~key~'#3'.~Check~the~spelling,~and~brace~any~value~that~contains~a~comma. }
\msg_new:nnn { cv-entries } { duplicate-key }
  { Entry~'#1':~key~'#2'~is~given~twice. }
\msg_new:nnn { cv-entries } { missing-value }
  { Entry~'#1':~'#2'~has~no~value~(expected~'key~=~value').~Brace~any~value~that~contains~a~comma. }
\msg_new:nnn { cv-entries } { missing-field }
  { Entry~'#1'~(#2):~required~key~'#3'~is~missing. }
\msg_new:nnn { cv-entries } { unknown-form }
  { Entry~'#1'~(#2)~has~no~'#3'~form.~Valid~forms:~#4. }
\msg_new:nnn { cv-entries } { no-forms }
  { Entry~'#1'~(#2)~has~no~forms;~remove~'[#3]'. }
\msg_new:nnn { cv-entries } { missing-bullets }
  { Entry~'#1':~no~bullets~for~the~'#2'~form.~Add~'#3~=~{...}',~or~'#3~=~none'~for~a~header-only~entry. }
\msg_new:nnn { cv-entries } { bad-date }
  { Entry~'#1':~'#2~=~#3'~is~not~a~valid~date.~Use~YYYY~or~YYYY-MM~(month~01-12)#4. }
\msg_new:nnn { cv-entries } { date-order }
  { Entry~'#1':~end~date~'#3'~is~before~start~date~'#2'. }
\msg_new:nnn { cv-entries } { date-keys }
  { Entry~'#1':~#2 }
\msg_new:nnn { cv-entries } { bad-bool }
  { Entry~'#1':~'#2'~must~be~true~or~false,~not~'#3'. }
\msg_new:nnn { cv-entries } { unconfirmed }
  { Reference~'#1'~is~marked~'confirmed~=~false'.~Only~render~referees~who~have~agreed~to~serve. }
\msg_new:nnn { cv-entries } { bad-name }
  { Cannot~define~entry~'#1':~entry~names~must~be~letters~only~(A-Z,~a-z),~so~that~\iow_char:N\\#1~can~be~called. }
\msg_new:nnn { cv-entries } { bad-bullets }
  { Entry~'#1':~'#2'~#3 }
\msg_new:nnn { cv-entries } { unknown-course }
  { Entry~'#1'~lists~the~course~'#2',~which~is~not~a~\iow_char:N\\DefineCourse~record. }
\msg_new:nnn { cv-entries } { duplicate-label }
  { Skills~'#1':~label~'#2'~is~given~twice. }
\msg_new:nnn { cv-entries } { bad-form }
  { \iow_char:N\\SetEntryForm:~unknown~form~'#1'~(use~full,~acad,~short,~or~tut). }

\cs_generate_variant:Nn \msg_error:nnnn   { nnee, nnen }
\cs_generate_variant:Nn \msg_error:nnnnn  { nneee, nnnne, nnnee }
\cs_generate_variant:Nn \msg_error:nnnnnn { nneeee }
\cs_generate_variant:Nn \prop_put:Nnn     { Nne, NnV, NVn }
\cs_generate_variant:Nn \regex_match:nnTF { nV }

% ------------------------------------------------------------
% Kind configuration
%   _forms    forms the kind can be rendered in (empty = formless)
%   _text     keys that may be overridden per form ("short title", ...)
%   _fixed    keys shared by every form
%   _required keys every record of the kind must give
% ------------------------------------------------------------
\clist_const:Nn \c__cv_all_forms_clist { full, acad, short, tut }

\clist_const:Nn \c__cv_position_forms_clist    { full, acad, short, tut }
\clist_const:Nn \c__cv_position_text_clist     { title, org, location, bullets, courses }
\clist_const:Nn \c__cv_position_fixed_clist    { start, end, date }
\clist_const:Nn \c__cv_position_required_clist { title }

% Courses: sub-entries of a position (the courses taught in a teaching role).
% A position lists them with "courses = {NameA, NameB}".
\clist_const:Nn \c__cv_course_forms_clist    { full, acad, short, tut }
\clist_const:Nn \c__cv_course_text_clist     { title, type, bullets }
\clist_const:Nn \c__cv_course_fixed_clist    { start, end, date }
\clist_const:Nn \c__cv_course_required_clist { title }

\clist_const:Nn \c__cv_publication_forms_clist    { full, short }
\clist_const:Nn \c__cv_publication_text_clist     { title, authors, venue, note }
\clist_const:Nn \c__cv_publication_fixed_clist    { date }
\clist_const:Nn \c__cv_publication_required_clist { title, authors, venue }

\clist_const:Nn \c__cv_presentation_forms_clist    { full, short }
\clist_const:Nn \c__cv_presentation_text_clist     { title, type, authors, venue, note }
\clist_const:Nn \c__cv_presentation_fixed_clist    { date }
\clist_const:Nn \c__cv_presentation_required_clist { title, type, venue }

\clist_const:Nn \c__cv_reference_forms_clist    { }
\clist_const:Nn \c__cv_reference_text_clist     { }
\clist_const:Nn \c__cv_reference_fixed_clist    { name, affiliation, relationship, email, phone, confirmed }
\clist_const:Nn \c__cv_reference_required_clist { name, affiliation, relationship, confirmed }

\clist_const:Nn \c__cv_skills_forms_clist    { }
\clist_const:Nn \c__cv_paragraph_forms_clist { }

% Kinds that carry a date (the date keys are required for these)
\clist_const:Nn \c__cv_dated_kinds_clist { position, course, publication, presentation }

\clist_const:Nn \c__cv_month_names_clist
  { Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec }

