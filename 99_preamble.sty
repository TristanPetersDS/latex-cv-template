} % new environment for highlights


\newenvironment{highlightsforbulletentries}{
    \begin{itemize}[
        topsep=0.10 cm,
        parsep=0.10 cm,
        partopsep=0pt,
        itemsep=0pt,
        leftmargin=10pt
    ]
}{
    \end{itemize}
} % new environment for highlights for bullet entries

\newenvironment{onecolentry}{
    \begin{adjustwidth}{
        0 cm + 0.00001 cm
    }{
        0 cm + 0.00001 cm
    }
}{
    \end{adjustwidth}
} % new environment for one column entries

\newenvironment{twocolentry}[2][]{
    \onecolentry
    \def\secondColumn{#2}
    \setcolumnwidth{\fill, 4.5 cm}
    \begin{paracol}{2}
}{
    \switchcolumn \raggedleft \secondColumn
    \end{paracol}
    \endonecolentry
} % new environment for two column entries

\newenvironment{threecolentry}[3][]{
    \onecolentry
    \def\thirdColumn{#3}
    \setcolumnwidth{, \fill, 4.5 cm}
    \begin{paracol}{3}
    {\raggedright #2} \switchcolumn
}{
    \switchcolumn \raggedleft \thirdColumn
    \end{paracol}
    \endonecolentry
} % new environment for three column entries

\newenvironment{header}{
    \setlength{\topsep}{0pt}\par\kern\topsep\centering\linespread{1.5}
}{
    \par\kern\topsep
} % new environment for the header

% Optional "Last updated in <month> <year>" stamp (the month and year of the
% build) in the top right corner of the first page. Call \placelastupdatedtext
% after \begin{document} to show it.
\newcommand{\lastupdatedtext}{Last updated in \ifcase\month\or January\or February\or March\or April\or May\or June\or July\or August\or September\or October\or November\or December\fi\ \the\year}
\newcommand{\placelastupdatedtext}{%
  \AddToShipoutPictureFG*{% add to the foreground of the current page
    \put(
        \LenToUnit{\paperwidth-2 cm-0 cm+0.05cm},
        \LenToUnit{\paperheight-1.0 cm}
    ){\vtop{{\null}\makebox[0pt][c]{
        \small\color{gray}\textit{\lastupdatedtext}\hspace{\widthof{\lastupdatedtext}}
    }}}%
  }%
}%

% save the original href command in a new command:
\let\hrefWithoutArrow\href

% Consistent icon+text macro (adjust spacing here if needed)
\newcommand{\iconitem}[3][primaryColor]{\textcolor{#1}{#2}\hspace{0.4em}#3}


% --- Header row of an entry, for entries typed by hand ---
% Bold title | institution -- location, with the date on the right. An empty
% institution or location is left out together with its separator.
% (97_entries.sty builds the same row for its records.)
% Usage: \newPosition{Title}{Institution}{Location}{Date Range}
\newcommand{\newPosition}[4]{%
  \begin{twocolentry}{%
    \textbf{#4}% Date Range
  }{%
    \textbf{#1}% Print Title (always present)
    %
    % Check for an Institution (argument #2)
    \ifthenelse{\equal{#2}{}}{%
      % If #2 is empty, do nothing
    }{%
      % If #2 is NOT empty, print the separator and the institution
      \ | #2%
    }%
    %
    % Check for a Location (argument #3)
    \ifthenelse{\equal{#3}{}}{%
      % If #3 is empty, do nothing
    }{%
      % If #3 is NOT empty, print the separator and the location
      \ -- \textit{#3}%
    }%
  }%
  \end{twocolentry}%
}

% --- Bullet list under an entry ---
% Usage: \positionEntries{ \item First point. \item Second point. }
\newcommand{\positionEntries}[1]{%
  \begin{onecolentry}
    \begin{highlights}
      #1% The list of \item commands
    \end{highlights}
  \end{onecolentry}%
}

% --- Commands to store personal data (set in 00_personal.tex) ---
\newcommand{\name}[1]{\def\@name{#1}}
\newcommand{\email}[1]{\def\@email{#1}}
\newcommand{\phone}[1]{\def\@phone{#1}}
\newcommand{\linkedin}[1]{\def\@linkedin{#1}}
\newcommand{\github}[1]{\def\@github{#1}}
\newcommand{\website}[1]{\def\@website{#1}}
\newcommand{\location}[1]{\def\@location{#1}}

% --- Every field starts empty; \makeheader skips empty fields ---
\name{}
\email{}
\phone{}
\linkedin{}
\github{}
\website{}
\location{}

% --- PDF metadata, taken from \name{} (98_cv_extras.sty replaces the title) ---
\AtBeginDocument{\hypersetup{pdfauthor={\@name}, pdftitle={\@name}}}

% --- Separator and header commands ---

\newcommand{\AND}{\unskip\cleaders\copy\ANDbox\hskip\wd\ANDbox\ignorespaces}
\newsavebox\ANDbox
\sbox\ANDbox{\kern 5pt$|$\kern 5pt}

\newif\ifcontactitemprinted
\newcommand{\makeheader}{%
  \begin{header}
    % Name
    {\fontsize{25pt}{25pt}\selectfont \@name}
    \vspace{5pt}
    \normalsize
    \contactitemprintedfalse

    % Contact Info Line
    % Location
    \@ifundefined{@location}{}{%
      \ifx\@location\@empty\else
        \mbox{\iconitem{\faMapMarker}{\@location}}%
        \contactitemprintedtrue
      \fi
    }
    % Email
    \@ifundefined{@email}{}{%
      \ifx\@email\@empty\else
        \ifcontactitemprinted \AND \fi
        \mbox{\hrefWithoutArrow{mailto:\@email}{\iconitem{\faEnvelope}{\@email}}}%
        \contactitemprintedtrue
      \fi
    }
    % Phone
    \@ifundefined{@phone}{}{%
      \ifx\@phone\@empty\else
        \ifcontactitemprinted \AND \fi
        \mbox{\iconitem{\faPhone}{\@phone}}%
        \contactitemprintedtrue
      \fi
    }
    % LinkedIn
    \@ifundefined{@linkedin}{}{%
      \ifx\@linkedin\@empty\else
        \ifcontactitemprinted \AND \fi
        \mbox{\hrefWithoutArrow{https://linkedin.com/in/\@linkedin}{\iconitem{\faLinkedin}{LinkedIn}}}%
        \contactitemprintedtrue
      \fi
    }
    % GitHub
    \@ifundefined{@github}{}{%
      \ifx\@github\@empty\else
        \ifcontactitemprinted \AND \fi
        \mbox{\hrefWithoutArrow{https://github.com/\@github}{\iconitem{\faGithub}{GitHub}}}%
        \contactitemprintedtrue
      \fi
    }
    % Website
    \@ifundefined{@website}{}{%
      \ifx\@website\@empty\else
        \ifcontactitemprinted \AND \fi
        \mbox{\hrefWithoutArrow{https://\@website}{\iconitem{\faGlobe}{\@website}}}%
        \contactitemprintedtrue
      \fi
    }
  \end{header}
  \vspace{\dimexpr 5pt - 0.3cm \relax}
}
